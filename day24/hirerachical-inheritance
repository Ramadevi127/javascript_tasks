//class person-->student & techer
class person{
    constructor(name){
        this.a=name
    }
    show(){
        console.log("name:",this.a);      
    }}
class student extends person{
    constructor(name,student){
        super(name,student)
        this.b=student
    }
    showstu(){
        super.show()
        console.log("student:",this.b);       
    }}
class teacher  extends person{
    constructor(name,teacher){
        super(name,teacher)
        this.c=teacher}
    showteach(){
        super.show()
        console.log("teacher:",this.c);    
    }}
let e=new teacher("rama","belongs to person")
e. showteach()
let f=new student("rama","belongs to person")
f.showstu()


// employee-->developer &manager
class Employee {
    constructor(name,id) {
        this.a = name;
        this.b = id;}
    display() {
        console.log("Name:",this.a);
        console.log("ID:",this.b);
    }}
class Developer extends Employee {
    constructor(name,id,language) {
        super(name,id);
        this.c=language;}
    showDeveloper() {
        super.display();
        console.log("Language:", this.c);
    }}
class Manager extends Employee {
    constructor(name,id,team) {
        super(name,id);
        this.team =team;
    }
    showManager() {
        super.display();
        console.log("Team:", this.team);
    }}
let d=new Developer("Rama",101,"Python");
d.showDeveloper();
let m=new Manager("hasini", 102, 10);
m.showManager();

